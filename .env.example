# Local-only settings. Copy to .env; never commit secrets.
NODE_ENV=development
AUTH_MODE=local
PORT=4000
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=./data/reasona.sqlite

# Google OAuth is intentionally unconfigured. Set only after you create the
# Google OAuth client, configure the consent screen and approve redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:4000/api/auth/google/callback
COOKIE_SECURE=false
# Generate/store securely for production; do not put a real value in source control.
SESSION_SECRET=

# Server-side model provider is disabled. Browser-local Qwen loading is a separate,
# explicit user action; no paid or remote provider is selected by default.
MODEL_PROVIDER=none
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_TIMEOUT_MS=30000
RESEARCH_EXECUTION_ENABLED=false
